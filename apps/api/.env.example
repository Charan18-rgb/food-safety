# API Proxy Environment Variables
# Copy this file to .env and fill in your values.

# The port the Express server will listen on (default 3001)
PORT=3001

# The Google Gemini API key used for OCR.
# Get one at: https://aistudio.google.com/app/apikey
# REQUIRED for production OCR. Keep this secret and NEVER expose it to the mobile client.
GEMINI_API_KEY=your_gemini_api_key_here

# Rate limit per IP in a 15-minute window (default 100)
RATE_LIMIT_MAX=100

# The timeout in milliseconds for the Gemini OCR request (default 15000)
OCR_TIMEOUT_MS=15000

# The allowed origin for CORS requests.
# For web, this should be the deployed web URL (e.g., https://foodgrade.example.com).
# For mobile clients, you can use '*' or leave it unset to default to '*'.
FRONTEND_ORIGIN=*

# Set to '1' if deploying behind a reverse proxy like Nginx, Cloudflare, or Vercel
# to ensure rate limiting uses the correct client IP.
TRUST_PROXY=1
