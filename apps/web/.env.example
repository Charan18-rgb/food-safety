# .env.example
# Web App / PWA Environment Variables

# The backend proxy endpoint that handles Gemini API requests
# This proxy is responsible for rate-limiting, payload validation, and injecting the GEMINI_API_KEY.
# DO NOT place the GEMINI_API_KEY directly in this file.
VITE_VISION_PROXY_ENDPOINT=https://your-backend-domain.com/api/v1/vision/ocr
