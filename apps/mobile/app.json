{
    "expo":  {
                 "name":  "FoodGrade",
                 "slug":  "foodgrade-mobile",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/images/icon.png",
                 "scheme":  "foodgrade",
                 "userInterfaceStyle":  "automatic",
                 "ios":  {
                             "icon":  "./assets/expo.icon"
                         },
                 "web":  {
                             "output":  "static",
                             "favicon":  "./assets/images/favicon.png"
                         },
                 "plugins":  [
                                 "expo-router",
                                 [
                                     "expo-splash-screen",
                                     {
                                         "backgroundColor":  "#208AEF",
                                         "image":  "./assets/images/splash-icon.png",
                                         "imageWidth":  76
                                     }
                                 ],
                                 "expo-sqlite",
                                 [
                                     "expo-camera",
                                     {
                                         "cameraPermission":  "Allow FoodGrade to access your camera to scan barcodes and photograph food labels for ingredient analysis."
                                     }
                                 ]
                             ],
                 "experiments":  {
                                     "typedRoutes":  true,
                                     "reactCompiler":  true
                                 },
                 "android":  {
                                 "package":  "in.foodgrade.app",
                                 "versionCode":  1
                             }
             }
}
