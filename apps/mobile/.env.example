# Mobile App Environment Variables
# Do NOT place any secrets (like GEMINI_API_KEY) in this file or the mobile project.

# The URL of the FoodGrade API backend proxy.
# In development, set this to your machine's LAN IP, e.g., http://192.168.1.100:3001/api/v1/vision/ocr
# In production, set this to your deployed backend URL, e.g., https://your-backend-domain.com/api/v1/vision/ocr
# If left blank, the app will explicitly fail on OCR scans rather than silently failing to connect to localhost.
EXPO_PUBLIC_API_URL=https://your-backend-domain.com/api/v1/vision/ocr
